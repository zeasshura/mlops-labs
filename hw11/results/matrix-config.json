                "memory": "128Mi"
              },
              "requests": {
                "cpu": "100m",
                "memory": "64Mi"
              }
            },
            "startupProbe": {
              "failureThreshold": 90,
              "httpGet": {
                "path": "/startup",
                "port": "http",
                "scheme": "HTTP"
              },
              "periodSeconds": 1,
              "successThreshold": 1,
              "timeoutSeconds": 1
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File"
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "restartPolicy": "Always",
